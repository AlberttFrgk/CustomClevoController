<Page
        x:Class="BSCustomClevoController.Views.Page_About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="780"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

    <Page.Resources>
        <Style x:Key="GithubButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AmoledButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="About &amp; Attribution" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                <TextBlock Text="Controller specifications, frameworks, and open-source credits" 
                           FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Top Hero Banner Card -->
            <Border Grid.Row="1" Style="{StaticResource AmoledCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="pack://application:,,,/BSCustomClevoController;component/Assets/main_icon.png"
                           Width="68" Height="68" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Custom Clevo Controller" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Amoled.TextPrimary}" />
                        <TextBlock Text="Open-source hardware controller for fan curves, keyboard lighting, battery health, and performance modes on Clevo laptops." 
                                   FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="OpenCurrentRepo_Click" Style="{StaticResource GithubButtonStyle}" 
                            Padding="14,8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                                  Fill="{StaticResource Amoled.TextPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="GitHub Repo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2-Column Section -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Core Capabilities & Frameworks -->
                <Border Grid.Column="0" Style="{StaticResource AmoledCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Section 1: Core Capabilities -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Core Capabilities" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,14" />

                            <!-- Feature 1: Thermal Control -->
                            <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Precision Thermal &amp; Fan Management" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Real-time CPU and GPU fan curve configuration, dynamic vendor theming, automatic cooling presets, and animated RPM telemetry." 
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Feature 2: Keyboard Backlight -->
                            <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Keyboard Lighting &amp; RGB Controls" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Complete control over multi-zone and per-key RGB lighting, brightness levels, colors, hardware modes, and software effects." 
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Feature 3: Power Modes -->
                            <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Hardware Power Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Direct hardware power mode switching between Performance, Entertainment, Quiet, and Power Save states via DCHU WMI." 
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Feature 4: Battery & FlexiCharger -->
                            <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Battery Health &amp; FlexiCharger" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Configurable start and stop charge thresholds (40% to 100%) to prevent high-voltage degradation when plugged into AC power." 
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Feature 5: System Tools & Diagnostics -->
                            <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics &amp; System Utilities" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Windows Airplane mode integration, keyboard lock controls, screen power saving, and hardware diagnostics." 
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Section 2: Open-Source Libraries & Frameworks -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Open-Source Libraries &amp; Frameworks" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,4,0,12" />

                            <Border Style="{StaticResource SubCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Hardware Driver Bridge" FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" />
                                        <TextBlock Text="Insyde DCHU Interface (InsydeDCHU.dll)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource Amoled.InnerCardBorder}" Margin="0,4" />
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Runtime Environment" FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" />
                                        <TextBlock Text=".NET Framework 4.7.2 (x64)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.Accent}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource Amoled.InnerCardBorder}" Margin="0,4" />
                                    <Grid Margin="0,3">
                                        <TextBlock Text="UI Presentation Framework" FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" />
                                        <TextBlock Text="MahApps.Metro WPF &amp; ControlzEx" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="{StaticResource Amoled.InnerCardBorder}" Margin="0,4" />
                                    <Grid Margin="0,3">
                                        <TextBlock Text="XAML Interactivity" FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" />
                                        <TextBlock Text="Microsoft.Xaml.Behaviors.Wpf" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Column: System Specs & Open Source Credits -->
                <StackPanel Grid.Column="2">
                    <!-- Community Credits & GitHub References -->
                    <Border Style="{StaticResource AmoledCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Community Credits &amp; References" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,14" />

                            <StackPanel Grid.Row="1">
                                <!-- Credit 1: Upstream Original Project -->
                                <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Ömer Faruk Boran" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                            </StackPanel>
                                            <Button Click="OpenUpstreamRepo_Click" Style="{StaticResource GithubButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
