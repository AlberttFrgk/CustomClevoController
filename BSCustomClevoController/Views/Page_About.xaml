                                                          Fill="{StaticResource Amoled.TextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="farukborann" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="Architectural foundation, Insyde DCHU DLL interop discovery, Clevo Control Center 3.0 power mode switching, and fan curve data structures." 
                                                   FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="15" />
                                    </Grid>
                                </Border>

                                <!-- Credit 2: Current Enhanced Project -->
                                <Border Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
