<Page
        x:Class="BSCustomClevoController.Views.Page_KeyboardSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

        <Page.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#FF101014" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF1E1E26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="#FFFFFF" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPresetButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Amoled.CardBorder}"
                                BorderThickness="1.5"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Amoled.CardBorderFocus}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Loc.KbTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
            <TextBlock Text="{DynamicResource Loc.KbSubtitle}" 
                       FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AmoledCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SubCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbBacklightHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                            <CheckBox x:Name="LedStatusCheckBox" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="LedStatusCheckBox_Checked" Unchecked="LedStatusCheckBox_Unchecked" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SubCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Loc.KbBrightnessTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="BrightnessPercentText" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="KeyboardBrightnessSlider" Grid.Row="1" Minimum="1" Maximum="4" Value="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                    Margin="0,8,0,8" VerticalAlignment="Center"
                                    Style="{StaticResource AmoledSliderStyle}" ValueChanged="KeyboardBrightnessSlider_ValueChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="QuickColorPresetsCard" Grid.Row="2" Style="{StaticResource SubCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Loc.KbQuickPresets}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="MonochromeColorBadge" Background="#1C1C24" BorderBrush="#3C3C46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Loc.KbSingleColorBadge}" FontSize="10" Foreground="{StaticResource Amoled.TextMuted}" />
                                    </Border>
                                    <Border x:Name="KeyboardColorModeBadge" Background="#141E2E" BorderBrush="#294569" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="KeyboardColorModeBadgeText" Text="{DynamicResource Loc.KbColorModeSingleLineRgb}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Amoled.Accent}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Rows="1" Columns="8" Margin="-3,0,-3,0">
                                <Button x:Name="PresetRed" Click="PresetColor_Click" Tag="#FF0000" Background="#FF0000" ToolTip="{DynamicResource Loc.KbColorRed}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetOrange" Click="PresetColor_Click" Tag="#FF8000" Background="#FF8000" ToolTip="{DynamicResource Loc.KbColorOrange}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetYellow" Click="PresetColor_Click" Tag="#FFFF00" Background="#FFFF00" ToolTip="{DynamicResource Loc.KbColorYellow}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetGreen" Click="PresetColor_Click" Tag="#00FF00" Background="#00FF00" ToolTip="{DynamicResource Loc.KbColorGreen}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetCyan" Click="PresetColor_Click" Tag="#00FFFF" Background="#00FFFF" ToolTip="{DynamicResource Loc.KbColorCyan}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetBlue" Click="PresetColor_Click" Tag="#0000FF" Background="#0000FF" ToolTip="{DynamicResource Loc.KbColorBlue}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetPurple" Click="PresetColor_Click" Tag="#FF00FF" Background="#FF00FF" ToolTip="{DynamicResource Loc.KbColorPurple}" Style="{StaticResource ColorPresetButtonStyle}" />
                                <Button x:Name="PresetWhite" Click="PresetColor_Click" Tag="#FFFFFF" Background="#FFFFFF" ToolTip="{DynamicResource Loc.KbColorWhite}" Style="{StaticResource ColorPresetButtonStyle}" />
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border x:Name="ColorCanvasCard" Grid.Row="3" Style="{StaticResource SubCardStyle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Loc.KbColorSpectrum}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ActiveZoneLabelText" Text="{DynamicResource Loc.KbColorModeSingleLine}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Border x:Name="ZoneSelectorCard" Background="#0B0B0E" BorderBrush="{StaticResource Amoled.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,10" Visibility="Collapsed">
                                    <UniformGrid Rows="1" Columns="4">
                                        <Button x:Name="ZoneAllBtn" Click="ZoneButton_Click" Tag="-1" Style="{StaticResource OpenSenseSegmentedPillActiveStyle}" Height="28" FontSize="11" Content="{DynamicResource Loc.KbZoneAll}" />
                                        <Button x:Name="ZoneLeftBtn" Click="ZoneButton_Click" Tag="0" Style="{StaticResource OpenSenseSegmentedPillButtonStyle}" Height="28" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ZoneLeftDot" Width="8" Height="8" Fill="#0078D7" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.KbZoneLeft}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ZoneCenterBtn" Click="ZoneButton_Click" Tag="1" Style="{StaticResource OpenSenseSegmentedPillButtonStyle}" Height="28" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ZoneCenterDot" Width="8" Height="8" Fill="#0078D7" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.KbZoneCenter}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ZoneRightBtn" Click="ZoneButton_Click" Tag="2" Style="{StaticResource OpenSenseSegmentedPillButtonStyle}" Height="28" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ZoneRightDot" Width="8" Height="8" Fill="#0078D7" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.KbZoneRight}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <Grid x:Name="SvPickerHost" Grid.Row="1" MinHeight="135" Cursor="Cross" ClipToBounds="True"
                                  MouseLeftButtonDown="SvPickerHost_MouseLeftButtonDown"
                                  MouseMove="SvPickerHost_MouseMove"
                                  MouseLeftButtonUp="SvPickerHost_MouseLeftButtonUp"
                                  SizeChanged="SvPickerHost_SizeChanged">
                                <Border x:Name="SvHueBackground" Background="#FF0078D7" CornerRadius="6" />
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="6" BorderBrush="{StaticResource Amoled.InnerCardBorder}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Canvas x:Name="SvThumbCanvas" IsHitTestVisible="False">
                                    <Border x:Name="SvPickerThumb" Width="16" Height="16" CornerRadius="8"
                                            BorderBrush="#FFFFFF" BorderThickness="2" Canvas.Left="0" Canvas.Top="0">
                                        <Border x:Name="SvPickerThumbFill" CornerRadius="6" BorderBrush="#AA000000" BorderThickness="1" Background="#FF0078D7" />
                                    </Border>
                                </Canvas>
                            </Grid>

                            <Grid x:Name="HueSliderHost" Grid.Row="2" Height="20" Margin="0,10,0,0" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonDown="HueSliderHost_MouseLeftButtonDown"
                                  MouseMove="HueSliderHost_MouseMove"
                                  MouseLeftButtonUp="HueSliderHost_MouseLeftButtonUp"
                                  SizeChanged="HueSliderHost_SizeChanged">
                                <Border Height="10" CornerRadius="5" VerticalAlignment="Center" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFF0000" Offset="0.000" />
                                            <GradientStop Color="#FFFFFF00" Offset="0.167" />
                                            <GradientStop Color="#FF00FF00" Offset="0.333" />
                                            <GradientStop Color="#FF00FFFF" Offset="0.500" />
                                            <GradientStop Color="#FF0000FF" Offset="0.667" />
                                            <GradientStop Color="#FFFF00FF" Offset="0.833" />
                                            <GradientStop Color="#FFFF0000" Offset="1.000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Canvas x:Name="HueThumbCanvas" VerticalAlignment="Center" Height="20" IsHitTestVisible="False">
                                    <Border x:Name="HueSliderThumb" Width="12" Height="18" CornerRadius="4"
                                            Background="#FFFFFF" BorderBrush="#FF0B0B0E" BorderThickness="2" Canvas.Left="0" Canvas.Top="1" />
                                </Canvas>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectedColorSwatch" Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                        Background="#FF0078D7" BorderBrush="#2E2E3A" BorderThickness="1.5" VerticalAlignment="Bottom" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="HEX" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextMuted}" Margin="2,0,0,3" />
                                    <TextBox x:Name="HexColorInput" Text="#0078D7" MaxLength="7" Style="{StaticResource AmoledTextBoxStyle}"
                                             Padding="8,5" FontSize="12" TextAlignment="Center"
                                             KeyDown="ColorInput_KeyDown" LostFocus="HexColorInput_LostFocus" TextChanged="HexColorInput_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="R" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" Margin="2,0,0,3" />
                                    <TextBox x:Name="RColorInput" Text="0" MaxLength="3" Style="{StaticResource AmoledTextBoxStyle}"
                                             Padding="4,5" FontSize="12" TextAlignment="Center"
                                             KeyDown="ColorInput_KeyDown" LostFocus="RgbColorInput_LostFocus" TextChanged="RgbColorInput_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="5">
                                    <TextBlock Text="G" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" Margin="2,0,0,3" />
                                    <TextBox x:Name="GColorInput" Text="120" MaxLength="3" Style="{StaticResource AmoledTextBoxStyle}"
                                             Padding="4,5" FontSize="12" TextAlignment="Center"
                                             KeyDown="ColorInput_KeyDown" LostFocus="RgbColorInput_LostFocus" TextChanged="RgbColorInput_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="7">
                                    <TextBlock Text="B" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" Margin="2,0,0,3" />
                                    <TextBox x:Name="BColorInput" Text="215" MaxLength="3" Style="{StaticResource AmoledTextBoxStyle}"
                                             Padding="4,5" FontSize="12" TextAlignment="Center"
                                             KeyDown="ColorInput_KeyDown" LostFocus="RgbColorInput_LostFocus" TextChanged="RgbColorInput_TextChanged" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AmoledCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbAnimationsHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                            <CheckBox x:Name="ModeStatus" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="ModeStatus_Checked" Unchecked="ModeStatus_Unchecked" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource Loc.KbSoftwareAnimations}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                <TextBlock x:Name="SoftwareAnimationSubtitle" Text="{DynamicResource Loc.KbSoftwareAnimationsSubtitle}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="SoftwareBatteryBadge" Background="#261214" BorderBrush="#E05252" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource Loc.KbDisabledOnBatteryBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#FF6B6B" />
                                </Border>
                                <CheckBox x:Name="SoftwareEffectsSwitch" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center" IsChecked="False"
                                          Click="SoftwareEffectsSwitch_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <ListBox x:Name="EffectsListBox"
                                     Background="{StaticResource Amoled.InnerCard}" 
                                     BorderBrush="{StaticResource Amoled.InnerCardBorder}" 
                                     BorderThickness="1"
                                     Padding="4"
                                     Foreground="{StaticResource Amoled.TextPrimary}" FontSize="13"
                                     ItemContainerStyle="{StaticResource AmoledListBoxItemStyle}"
                                     SelectionChanged="EffectsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding LocalizedName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{StaticResource Amoled.CardBackground}" BorderBrush="{StaticResource Amoled.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{StaticResource Amoled.TextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="NoEffectsMessage"
                                       Text="{DynamicResource Loc.KbNoEffectsTurnOn}"
                                       FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Margin="16" />
                        </Grid>

                        <Grid x:Name="AnimationSpeedRow" Grid.Row="3" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbAnimationSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SpeedSlowBtn" Grid.Column="0" Content="{DynamicResource Loc.KbSpeedSlow}" Style="{StaticResource AmoledButtonStyle}" MinHeight="32" Padding="10,4" FontSize="11" Click="SpeedBtn_Click" Tag="1" />
                                <Button x:Name="SpeedNormalBtn" Grid.Column="2" Content="{DynamicResource Loc.KbSpeedNormal}" Style="{StaticResource AmoledAccentButtonStyle}" MinHeight="32" Padding="10,4" FontSize="11" Click="SpeedBtn_Click" Tag="2" />
                                <Button x:Name="SpeedFastBtn" Grid.Column="4" Content="{DynamicResource Loc.KbSpeedFast}" Style="{StaticResource AmoledButtonStyle}" MinHeight="32" Padding="10,4" FontSize="11" Click="SpeedBtn_Click" Tag="3" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource AmoledCardStyle}" Padding="18,14">
                    <StackPanel>
                        <Grid x:Name="LightBarRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbLightBar}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="LightBarBadge" Background="#1C1C24" BorderBrush="#3C3C46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc.CommonNotSupported}" FontSize="10" Foreground="{StaticResource Amoled.TextMuted}" />
                                </Border>
                                <CheckBox x:Name="LightBarCheckBox" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="LightBarCheckBox_Checked" Unchecked="LightBarCheckBox_Unchecked" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="LogoRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbLogoLighting}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="LogoBadge" Background="#1C1C24" BorderBrush="#3C3C46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc.CommonNotSupported}" FontSize="10" Foreground="{StaticResource Amoled.TextMuted}" />
                                </Border>
                                <CheckBox x:Name="LogoCheckBox" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="LogoCheckBox_Checked" Unchecked="LogoCheckBox_Unchecked" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TouchpadLedRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.KbTouchpadLighting}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="TouchpadLedBadge" Background="#1C1C24" BorderBrush="#3C3C46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc.CommonNotSupported}" FontSize="10" Foreground="{StaticResource Amoled.TextMuted}" />
                                </Border>
                                <CheckBox x:Name="TouchpadLedCheckBox" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="TouchpadLedCheckBox_Checked" Unchecked="TouchpadLedCheckBox_Unchecked" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="BootEffectRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource Loc.KbBootEffect}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc.KbBootEffectDesc}" 
                                           FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="BootEffectBadge" Background="#1C1C24" BorderBrush="#3C3C46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc.CommonNotSupported}" FontSize="10" Foreground="{StaticResource Amoled.TextMuted}" />
                                </Border>
                                <CheckBox x:Name="BootEffectCheckBox" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Checked="BootEffectCheckBox_Checked" Unchecked="BootEffectCheckBox_Unchecked" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource Amoled.InnerCardBorder}" Margin="0,0,0,10" />

                        <Grid x:Name="SleepTimeoutContainer">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Loc.KbSleepTimeout}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc.KbSleepNeverNote}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Loc.KbHours}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="2,0,0,4" />
                                    <TextBox x:Name="KeyboarSleepTimerHours" Text="0" Style="{StaticResource AmoledTextBoxStyle}" TextAlignment="Center"
                                             KeyDown="KeyboarSleepTimer_KeyDown" LostFocus="KeyboarSleepTimer_LostFocus" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Loc.KbMinutes}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="2,0,0,4" />
                                    <TextBox x:Name="KeyboarSleepTimerMunites" Text="0" Style="{StaticResource AmoledTextBoxStyle}" TextAlignment="Center"
                                             KeyDown="KeyboarSleepTimer_KeyDown" LostFocus="KeyboarSleepTimer_LostFocus" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Loc.KbSeconds}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="2,0,0,4" />
                                    <TextBox x:Name="KeyboarSleepTimerSeconds" Text="0" Style="{StaticResource AmoledTextBoxStyle}" TextAlignment="Center"
                                             KeyDown="KeyboarSleepTimer_KeyDown" LostFocus="KeyboarSleepTimer_LostFocus" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
