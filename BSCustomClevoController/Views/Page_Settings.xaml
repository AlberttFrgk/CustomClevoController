<Page
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="BSCustomClevoController.Views.Page_Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings &amp; Maintenance" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
            <TextBlock Text="Startup preferences, on-screen display, driver status, and hardware reset" 
                       FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- 2-Column Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Application Preferences -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource AmoledCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Startup Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,16" />

                        <!-- Start with Windows (Minimized to Tray) -->
                        <Border Grid.Row="1" Style="{StaticResource SubCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Run at Windows Startup" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Starts minimized in the background on startup so fan and power profiles apply automatically."
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                </StackPanel>

                                <CheckBox x:Name="StartupCheckBox" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center" Margin="14,0,0,0" Click="StartupCheckBox_Click" />
                            </Grid>
                        </Border>

                        <!-- System Tray Behavior Hint -->
                        <Border Grid.Row="2" Style="{StaticResource SubCardStyle}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 s 4.48 10 10 10 10 -4.48 10 -10 S 17.52 2 12 2 z m 1 15 h -2 v -6 h 2 v 6 z m 0 -8 h -2 V 7 h 2 v 2 z"
                                      Fill="{StaticResource Amoled.Accent}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Closing or minimizing the window keeps the controller active in the system tray. Double-click the tray icon to reopen anytime."
                                           FontSize="11" Foreground="{StaticResource Amoled.TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="16" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- On-Screen Display Card -->
                <Border Style="{StaticResource AmoledCardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="On-Screen Display (OSD)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,16" />

                        <Border Grid.Row="1" Style="{StaticResource SubCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show On-Screen Display (OSD)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Shows visual notifications on screen when changing volume, brightness, fan speed, or power modes."
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                </StackPanel>

                                <CheckBox x:Name="OsdCheckBox" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}"
                                          VerticalAlignment="Center" Margin="14,0,0,0" Click="OsdCheckBox_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Maintenance & Power Card (Moved under OSD) -->
                <Border Style="{StaticResource AmoledCardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Maintenance &amp; Hardware Driver" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,16" />

                        <!-- ACPI Kernel Driver Status -->
                        <Border Grid.Row="1" Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ACPI Kernel Driver (AcpiBridge)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock x:Name="DriverStatusDesc" Text="Hardware driver interface for fan speeds, power modes, battery limits, and hotkeys."
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                </StackPanel>

                                <Border x:Name="DriverStatusBadge" Grid.Column="1" CornerRadius="10" Padding="10,3" BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="DriverStatusText" Text="Checking..." FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <Button x:Name="ReinstallDriverBtn" Grid.Column="2" Content="Reinstall" Click="ReinstallDriver_Click"
                                        Style="{StaticResource AmoledButtonStyle}" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Button x:Name="UninstallDriverBtn" Grid.Column="3" Content="Uninstall" Click="UninstallDriver_Click"
                                        Style="{StaticResource AmoledButtonStyle}" Padding="12,6" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Reset to Factory Settings -->
                        <Border Grid.Row="2" Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Reset to Factory Defaults" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Restores power modes, fan curves, and keyboard lighting back to factory defaults."
                                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                </StackPanel>

                                <Button x:Name="ResetFactoryBtn" Grid.Column="1" Content="Reset" Click="ResetFactory_Click"
                                        Style="{StaticResource AmoledButtonStyle}" Padding="16,6" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Column: Hardware EC Capabilities Diagnostic -->
            <Border Grid.Column="2" Style="{StaticResource AmoledCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Hardware Features &amp; Capabilities" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CopyCapabilitiesBtn" Content="Copy All" Click="CopyCapabilities_Click"
                                    Style="{StaticResource AmoledButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="Refresh" Click="RefreshCapabilities_Click"
                                    Style="{StaticResource AmoledButtonStyle}" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="FeaturesListBox" Grid.Row="1"
                             Background="{StaticResource Amoled.InnerCard}"
                             BorderBrush="{StaticResource Amoled.InnerCardBorder}"
                             BorderThickness="1"
                             Padding="4"
                             Foreground="{StaticResource Amoled.TextPrimary}"
                             FontSize="12" Margin="0,0,0,12"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource Amoled.TextPrimary}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" />

                                    <Border x:Name="BadgeBorder" 
                                            Grid.Column="1" 
                                            CornerRadius="10" 
                                            Padding="9,2" 
                                            BorderThickness="1" 
                                            VerticalAlignment="Center" 
                                            Margin="8,0,0,0">
                                        <TextBlock x:Name="BadgeText" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSupported}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#1A2D42" />
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#2563EB" />
                                        <Setter TargetName="BadgeText" Property="Text" Value="Supported" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#79CFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#14171E" />
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#262B36" />
                                        <Setter TargetName="BadgeText" Property="Text" Value="Not Supported" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#7D8590" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Background="{StaticResource Amoled.InnerCard}" BorderBrush="{StaticResource Amoled.CardBorder}" BorderThickness="1">
                                <MenuItem Header="Copy All" Click="CopyAll_Click" Foreground="{StaticResource Amoled.TextPrimary}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Displays hardware features detected directly from your laptop motherboard." 
                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
