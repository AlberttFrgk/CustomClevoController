<Page
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="BSCustomClevoController.Views.Page_Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Loc.SettingsTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
            <TextBlock Text="{DynamicResource Loc.SettingsSubtitle}" 
                       FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource AmoledCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Loc.SettingsLanguageHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,14" />

                            <Border Grid.Row="1" Style="{StaticResource SubCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.SettingsAppLanguage}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                        <TextBlock Text="{DynamicResource Loc.SettingsAppLanguageDesc}"
                                                   FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                    </StackPanel>

                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                              Background="{StaticResource Amoled.InnerCard}" Foreground="{StaticResource Amoled.TextPrimary}"
                                              BorderBrush="{StaticResource Amoled.InnerCardBorder}"
                                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AmoledCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Loc.SettingsOsdHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,16" />

                            <Border Grid.Row="1" Style="{StaticResource SubCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.SettingsShowOsd}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                        <TextBlock Text="{DynamicResource Loc.SettingsShowOsdDesc}"
                                                   FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                    </StackPanel>

                                    <CheckBox x:Name="OsdCheckBox" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}"
                                              VerticalAlignment="Center" Margin="14,0,0,0" Click="OsdCheckBox_Click" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AmoledCardStyle}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Loc.SettingsMaintenanceHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,16" />

                            <Border Grid.Row="1" Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.SettingsDriverTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                        <TextBlock x:Name="DriverStatusDesc" Text="{DynamicResource Loc.SettingsDriverDesc}"
                                                   FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                    </StackPanel>

                                    <Border x:Name="DriverStatusBadge" Grid.Column="1" CornerRadius="10" Padding="10,3" BorderThickness="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock x:Name="DriverStatusText" Text="{DynamicResource Loc.SettingsStatusChecking}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>

                                    <Button x:Name="ReinstallDriverBtn" Grid.Column="2" Content="{DynamicResource Loc.SettingsReinstall}" Click="ReinstallDriver_Click"
                                            Style="{StaticResource AmoledButtonStyle}" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Button x:Name="UninstallDriverBtn" Grid.Column="3" Content="{DynamicResource Loc.SettingsUninstall}" Click="UninstallDriver_Click"
                                            Style="{StaticResource AmoledButtonStyle}" Padding="12,6" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource SubCardStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.SettingsResetTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                        <TextBlock Text="{DynamicResource Loc.SettingsResetDesc}"
                                                   FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15" />
                                    </StackPanel>

                                    <Button x:Name="ResetFactoryBtn" Grid.Column="1" Content="{DynamicResource Loc.SettingsResetBtn}" Click="ResetFactory_Click"
                                            Style="{StaticResource AmoledButtonStyle}" Padding="16,6" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource AmoledCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Loc.SettingsCapabilitiesHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CopyCapabilitiesBtn" Content="{DynamicResource Loc.SettingsCopyAll}" Click="CopyCapabilities_Click"
                                    Style="{StaticResource AmoledButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                            <Button Content="{DynamicResource Loc.SettingsRefresh}" Click="RefreshCapabilities_Click"
                                    Style="{StaticResource AmoledButtonStyle}" Padding="10,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="FeaturesListBox" Grid.Row="1"
                             Background="{StaticResource Amoled.InnerCard}"
                             BorderBrush="{StaticResource Amoled.InnerCardBorder}"
                             BorderThickness="1"
                             Padding="4"
                             Foreground="{StaticResource Amoled.TextPrimary}"
                             FontSize="12" Margin="0,0,0,12"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource Amoled.TextPrimary}" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" />

                                    <Border x:Name="BadgeBorder" 
                                            Grid.Column="1" 
                                            CornerRadius="10" 
                                            Padding="9,2" 
                                            BorderThickness="1" 
                                            VerticalAlignment="Center" 
                                            Margin="8,0,0,0">
                                        <TextBlock x:Name="BadgeText" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSupported}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#1A2D42" />
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#2563EB" />
                                        <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Loc.SettingsSupported}" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#79CFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#14171E" />
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#262B36" />
                                        <Setter TargetName="BadgeText" Property="Text" Value="{DynamicResource Loc.SettingsNotSupported}" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#7D8590" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Background="{StaticResource Amoled.InnerCard}" BorderBrush="{StaticResource Amoled.CardBorder}" BorderThickness="1">
                                <MenuItem Header="{DynamicResource Loc.SettingsCopyAll}" Click="CopyAll_Click" Foreground="{StaticResource Amoled.TextPrimary}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="{DynamicResource Loc.SettingsCapabilitiesFooter}" 
                               FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
