<Page
        x:Class="BSCustomClevoController.Views.Page_PerformanceSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="760"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

    <Page.Resources>
        <Style x:Key="ModeCardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource Amoled.CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Amoled.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinHeight" Value="385" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Amoled.CardBackgroundHover}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Amoled.CardBorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Power &amp; Performance" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                <TextBlock Text="Performance modes to balance laptop speed, power, and fan noise" 
                           FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- 4 Mode Cards Grid -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quiet Mode -->
                <Button x:Name="QuietModeBtn" Style="{StaticResource ModeCardButtonStyle}" Grid.Column="0"
                        Click="QuietModeBtn_Click" MouseMove="QuietModeBtn_MouseMove">
                    <Grid Margin="18,24,18,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Border x:Name="QuietActiveBadge" Background="#1B365D" BorderBrush="{StaticResource Amoled.Accent}" BorderThickness="1" CornerRadius="6" Padding="9,3" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                            <TextBlock x:Name="QuietActiveText" Text="Active" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" />
                        </Border>
                        
                        <Image Source="pack://application:,,,/BSCustomClevoController;component/Assets/Page_PerformanceSettings/icon_slient.png" 
                               Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,20" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <TextBlock x:Name="QuietModeBtnText" Text="Quiet" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource Amoled.TextPrimary}" TextAlignment="Center" Grid.Row="2" />
                        <TextBlock Text="Fans run at minimum speed for quiet environments" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" Grid.Row="3" />
                    </Grid>
                </Button>

                <!-- Power Saving Mode -->
                <Button x:Name="PowerSaveModeBtn" Style="{StaticResource ModeCardButtonStyle}" Grid.Column="1"
                        Click="PowerSaveModeBtn_Click" MouseMove="PowerSaveModeBtn_MouseMove">
                    <Grid Margin="18,24,18,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Border x:Name="PowerSaveActiveBadge" Background="#1B365D" BorderBrush="{StaticResource Amoled.Accent}" BorderThickness="1" CornerRadius="6" Padding="9,3" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                            <TextBlock x:Name="PowerSaveActiveText" Text="Active" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" />
                        </Border>
                        
                        <Image Source="pack://application:,,,/BSCustomClevoController;component/Assets/Page_PerformanceSettings/icon_powersave.png" 
                               Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,20" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <TextBlock x:Name="PowerSaveModeBtnText" Text="Power Saver" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource Amoled.TextPrimary}" TextAlignment="Center" Grid.Row="2" />
                        <TextBlock Text="Reduces power consumption to maximize battery life" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" Grid.Row="3" />
                    </Grid>
                </Button>

                <!-- Entertainment Mode -->
                <Button x:Name="EntertainmentModeBtn" Style="{StaticResource ModeCardButtonStyle}" Grid.Column="2"
                        Click="EntertainmentModeBtn_Click" MouseMove="EntertainmentModeBtn_MouseMove">
                    <Grid Margin="18,24,18,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Border x:Name="EntertainmentActiveBadge" Background="#1B365D" BorderBrush="{StaticResource Amoled.Accent}" BorderThickness="1" CornerRadius="6" Padding="9,3" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                            <TextBlock x:Name="EntertainmentActiveText" Text="Active" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" />
                        </Border>
                        
                        <Image Source="pack://application:,,,/BSCustomClevoController;component/Assets/Page_PerformanceSettings/icon_entartainment.png" 
                               Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,20" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <TextBlock x:Name="EntertainmentModeBtnText" Text="Entertainment" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource Amoled.TextPrimary}" TextAlignment="Center" Grid.Row="2" />
                        <TextBlock Text="Balanced power and cooling for daily tasks and gaming" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" Grid.Row="3" />
                    </Grid>
                </Button>

                <!-- Full Performance Mode -->
                <Button x:Name="PerformanceModeBtn" Style="{StaticResource ModeCardButtonStyle}" Grid.Column="3"
                        Click="PerformanceModeBtn_Click" MouseMove="PerformanceModeBtn_MouseMove">
                    <Grid Margin="18,24,18,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <Border x:Name="PerformanceActiveBadge" Background="#1B365D" BorderBrush="{StaticResource Amoled.Accent}" BorderThickness="1" CornerRadius="6" Padding="9,3" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Hidden">
                            <TextBlock x:Name="PerformanceActiveText" Text="Active" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" />
                        </Border>
                        
                        <Image Source="pack://application:,,,/BSCustomClevoController;component/Assets/Page_PerformanceSettings/icon_performance.png" 
                               Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,20" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <TextBlock x:Name="PerformanceModeBtnText" Text="Performance" FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource Amoled.TextPrimary}" TextAlignment="Center" Grid.Row="2" />
                        <TextBlock Text="Maximum power and cooling for heavy workloads and gaming" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" Grid.Row="3" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Section 2: Profile Details -->
            <Border Grid.Row="2" Style="{StaticResource AmoledCardStyle}" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Profile Details" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1" x:Name="modeDetais" FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" TextWrapping="Wrap" 
                               VerticalAlignment="Center" LineHeight="17" />
                </Grid>
            </Border>

            <!-- Section 3: Hardware Policies & Power Tuning -->
            <Border Grid.Row="3" Style="{StaticResource AmoledCardStyle}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="Hardware Energy Policies" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" Margin="0,0,0,12" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Energy Star 1.5C -->
                        <Border x:Name="EnergyStarCard" Grid.Column="0" Style="{StaticResource SubCardStyle}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Deep Sleep (Energy Star)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Enables low-power sleep when idle to reduce power consumption" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="EnergyStarSwitch" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}" Click="EnergyStarSwitch_Click" VerticalAlignment="Center" IsChecked="True" />
                            </Grid>
                        </Border>

                        <!-- Right Column: PCIe ASPM Dynamic Tuning -->
                        <Border x:Name="DynamicTuningCard" Grid.Column="2" Style="{StaticResource SubCardStyle}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PCIe Power Saving (ASPM)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="Reduces power consumption of internal devices (graphics and storage) when idle" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="DynamicTuningSwitch" Grid.Column="1" Style="{StaticResource AmoledToggleSwitchStyle}" Click="DynamicTuningSwitch_Click" VerticalAlignment="Center" IsChecked="True" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
