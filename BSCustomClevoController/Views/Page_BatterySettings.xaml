<Page
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="BSCustomClevoController.Views.Page_BatterySettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720"
        d:DesignWidth="1280"
        Background="{DynamicResource Amoled.Background}">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Loc.BatTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
            <TextBlock Text="{DynamicResource Loc.BatSubtitle}" 
                       FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AmoledCardStyle}" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="M 10,2 L 18,5 V 10 C 18,15 14.5,19.5 10,21 C 5.5,19.5 2,15 2,10 V 5 Z M 8.5,14.5 L 15,8 L 13.5,6.5 L 8.5,11.5 L 6.5,9.5 L 5,11 Z"
                              Fill="{StaticResource Amoled.Accent}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.BatOptions}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SubCardStyle}" Padding="12,8" Margin="0,0,0,7">
                        <RadioButton x:Name="MaxChargeRadio" GroupName="BatteryChargeModeGroup" Style="{StaticResource AmoledRadioButtonStyle}" Checked="ChargeRadio_Checked">
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="{DynamicResource Loc.BatMax}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                <TextBlock Text="{DynamicResource Loc.BatMaxDesc}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SubCardStyle}" Padding="12,8" Margin="0,0,0,7">
                        <RadioButton x:Name="RecommendedChargeRadio" GroupName="BatteryChargeModeGroup" Style="{StaticResource AmoledRadioButtonStyle}" Checked="ChargeRadio_Checked">
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="{DynamicResource Loc.BatHealth}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                <TextBlock Text="{DynamicResource Loc.BatHealthDesc}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource SubCardStyle}" Padding="12,8" Margin="0,0,0,6">
                        <StackPanel>
                            <RadioButton x:Name="CustomChargeRadio" GroupName="BatteryChargeModeGroup" Style="{StaticResource AmoledRadioButtonStyle}" Checked="ChargeRadio_Checked">
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="{DynamicResource Loc.BatCustom}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.BatCustomDesc}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Grid x:Name="CustomThresholdPanel" Margin="28,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.BatStartUnder}" FontSize="11.5" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <TextBox x:Name="CustomStartBox" Text="90" Style="{StaticResource AmoledTextBoxStyle}" Padding="8,4" TextAlignment="Center" FontSize="12.5" MaxLength="2"
                                             LostFocus="CustomThresholdBox_LostFocus" KeyDown="CustomThresholdBox_KeyDown" />
                                </Grid>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.BatStopAt}" FontSize="11.5" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <TextBox x:Name="CustomStopBox" Text="100" Style="{StaticResource AmoledTextBoxStyle}" Padding="8,4" TextAlignment="Center" FontSize="12.5" MaxLength="3"
                                             LostFocus="CustomThresholdBox_LostFocus" KeyDown="CustomThresholdBox_KeyDown" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="BatteryStatusText" Grid.Row="4" VerticalAlignment="Center"
                               FontSize="11.5" FontWeight="SemiBold" Margin="4,2,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource AmoledCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource Loc.BatLiveStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,14" />

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.BatCurrentLevel}" FontSize="13" Foreground="{StaticResource Amoled.TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveBatteryPercentText" Grid.Column="1" Text="100%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Amoled.Accent}" />
                        </Grid>

                        <ProgressBar x:Name="LiveBatteryProgressBar" Grid.Row="2" 
                                     Style="{StaticResource AmoledProgressBarStyle}"
                                     Height="8" Value="100" Minimum="0" Maximum="100"
                                     Margin="0,0,0,16" />

                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.BatPowerSource}" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" />
                            <TextBlock x:Name="LivePowerSourceText" Grid.Column="1" Text="AC Connected" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.BatVoltage}" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" />
                            <TextBlock x:Name="LiveVoltageText" Grid.Column="1" Text="-- V" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.BatChargeRate}" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" />
                            <TextBlock x:Name="LiveChargeRateText" Grid.Column="1" Text="-- W" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" />
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Loc.BatActiveLimit}" FontSize="12" Foreground="{StaticResource Amoled.TextMuted}" />
                            <TextBlock x:Name="LiveLimitStatusText" Grid.Column="1" Text="{DynamicResource Loc.BatLimitDisabled}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.Accent}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AmoledCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.BatCareGuideHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextSecondary}" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Loc.BatCareGuideQuestion}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Amoled.TextPrimary}" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource Loc.BatCareGuideIntro}"
                                   FontSize="12" Foreground="{StaticResource Amoled.TextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource Loc.BatCareGuideRec}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Loc.BatCareGuideMax}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Loc.BatCareGuideCustom}" FontSize="11" Foreground="{StaticResource Amoled.TextMuted}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
