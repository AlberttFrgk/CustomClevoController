    <Style x:Key="OpenSenseTileValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OpenSenseBigNumberStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="44" />
