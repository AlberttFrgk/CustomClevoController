        <Setter Property="BorderBrush" Value="{StaticResource Amoled.InnerCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AmoledButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#141419" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amoled.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#202028" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Amoled.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#0C0C10" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledAccentButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Amoled.Accent}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Amoled.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1BA1E2" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#1BA1E2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#005A9E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AmoledAccentButtonStyle}" />

    <Style x:Key="GithubButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AmoledButtonStyle}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ColorPresetButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="16" Margin="-2" />
                        <Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="14" SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Amoled.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeCardButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource Amoled.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amoled.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Amoled.CardBackgroundHover}" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Amoled.CardBorderFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource Amoled.InnerCard}" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Amoled.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amoled.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#2E2E3A" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Amoled.Accent}" />
                            <Setter TargetName="Border" Property="Background" Value="#14141A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDarkTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource AmoledTextBoxStyle}" />

    <Style x:Key="AmoledProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="#14171E" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid SnapsToDevicePixels="True" Height="{TemplateBinding Height}">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Amoled.InnerCardBorder}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource AmoledProgressBarStyle}" />

    <Style x:Key="AmoledSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" Height="24">
                        <Border x:Name="TrackBackground" Height="4" Background="#1E1E26" CornerRadius="2" VerticalAlignment="Center" />

                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" VerticalAlignment="Center">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" Height="24" VerticalAlignment="Center">
                                                <Border Height="4" VerticalAlignment="Center" Background="{StaticResource Amoled.Accent}" CornerRadius="2" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" VerticalAlignment="Center">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" Height="24" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="24" Cursor="Hand" VerticalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="12" Height="24" Background="Transparent">
                                                <Ellipse x:Name="HoverRing" Width="18" Height="18" Fill="{StaticResource Amoled.Accent}" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <Ellipse x:Name="ThumbDot" Width="12" Height="12" Fill="{StaticResource Amoled.Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverRing" Property="Opacity" Value="0.25" />
                                                    <Setter TargetName="ThumbDot" Property="Fill" Value="#2A9DFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="HoverRing" Property="Opacity" Value="0.4" />
                                                    <Setter TargetName="ThumbDot" Property="Fill" Value="#4FB0FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="OuterCircle" Width="18" Height="18" Stroke="{StaticResource Amoled.CardBorder}" StrokeThickness="2" Fill="{StaticResource Amoled.InnerCard}" VerticalAlignment="Center" />
                        <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="{StaticResource Amoled.Accent}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource Amoled.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource Amoled.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledToggleSwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#181820" BorderBrush="#262632" BorderThickness="1" SnapsToDevicePixels="True">
                            <Canvas Width="42" Height="20">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#CBD5E1" Canvas.Left="2" Canvas.Top="2" />
                            </Canvas>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Amoled.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Amoled.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Thumb" Property="Canvas.Left" Value="24" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AmoledListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="ActivePill" Width="3" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" Margin="2,4,0,4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#15151C" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#1C1C26" />
                            <Setter TargetName="ActivePill" Property="Background" Value="{StaticResource Amoled.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="OpenSense.Temp.Cool" Color="#3DB8F5" options:Freeze="True" />
    <SolidColorBrush x:Key="OpenSense.Temp.Warm" Color="#3DD68C" options:Freeze="True" />
    <SolidColorBrush x:Key="OpenSense.Temp.Hot" Color="#FFB224" options:Freeze="True" />
    <SolidColorBrush x:Key="OpenSense.Temp.Critical" Color="#FF4D4D" options:Freeze="True" />

    <Style x:Key="OpenSensePageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Amoled.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="OpenSenseSectionHeaderStyle" TargetType="{x:Type TextBlock}">
